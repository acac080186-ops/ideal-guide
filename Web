<!DOCTYPE html>
<html lang="th" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sunlight Hub - รวมสคริปต์สุดล้ำ</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        darkBg: '#0a0a0a',
                        cardBg: '#1a0b2e',
                        neonPurple: '#a855f7',
                        neonGlow: '#c084fc',
                    },
                    fontFamily: {
                        kanit: ['Kanit', 'sans-serif'],
                    },
                }
            }
        }
    </script>
    <!-- Google Fonts: Kanit -->
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Custom Neon Glow Styles -->
    <style>
        body {
            font-family: 'Kanit', sans-serif;
            background-color: #0a0a0a;
            color: #ffffff;
            overflow-x: hidden;
        }
        .neon-border {
            border: 1px solid rgba(168, 85, 247, 0.4);
            box-shadow: 0 0 15px rgba(168, 85, 247, 0.2);
            transition: all 0.3s ease;
        }
        .neon-border:hover {
            border-color: rgba(168, 85, 247, 0.8);
            box-shadow: 0 0 25px rgba(168, 85, 247, 0.4);
        }
        .neon-button {
            background: linear-gradient(135deg, #9333ea, #a855f7);
            box-shadow: 0 0 15px rgba(168, 85, 247, 0.4);
            transition: all 0.3s ease;
        }
        .neon-button:hover {
            box-shadow: 0 0 25px rgba(168, 85, 247, 0.8);
            transform: translateY(-2px);
        }
        .glassmorphism {
            background: rgba(26, 11, 46, 0.65);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }
        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #0a0a0a;
        }
        ::-webkit-scrollbar-thumb {
            background: #4c1d95;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #7e22ce;
        }
    </style>
</head>
<body class="bg-darkBg text-white min-h-screen flex flex-col selection:bg-purple-500 selection:text-white">

    <!-- Navigation Bar -->
    <header class="sticky top-0 z-40 glassmorphism border-b border-purple-900/40 px-4 sm:px-8 py-4 flex items-center justify-between">
        <div class="flex items-center space-x-3 cursor-pointer" onclick="window.scrollTo({top: 0, behavior: 'smooth'})">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-purple-700 to-pink-500 flex items-center justify-center shadow-lg shadow-purple-500/30">
                <i class="fa-solid fa-sun text-xl text-white animate-spin-slow"></i>
            </div>
            <span class="text-xl sm:text-2xl font-bold tracking-wider bg-gradient-to-r from-white via-purple-200 to-neonPurple bg-clip-text text-transparent">
                Sunlight Hub
            </span>
        </div>

        <!-- Admin Toggle Button -->
        <button onclick="toggleAdminModal(true)" class="flex items-center space-x-2 px-4 py-2 rounded-xl border border-purple-500/50 bg-purple-950/40 text-purple-300 hover:bg-purple-900/60 hover:text-white transition-all duration-300 shadow-lg shadow-purple-900/20 text-sm sm:text-base font-medium">
            <i class="fa-solid fa-shield-halved text-neonPurple"></i>
            <span>Admin Panel</span>
        </button>
    </header>

    <!-- Hero Section -->
    <section class="relative px-4 sm:px-8 pt-12 pb-8 text-center max-w-4xl mx-auto">
        <div class="absolute inset-0 -z-10 flex items-center justify-center opacity-20 pointer-events-none">
            <div class="w-96 h-96 bg-purple-600 rounded-full filter blur-[120px]"></div>
        </div>
        <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight mb-4 bg-gradient-to-r from-white via-purple-300 to-neonPurple bg-clip-text text-transparent drop-shadow-sm">
            Sunlight Hub
        </h1>
        <p class="text-base sm:text-xl text-purple-200/80 mb-8 font-light">
            กำลังหาติสอยู่รึป่าว? ติสพวกเรา ✨ ศูนย์รวมสคริปต์คุณภาพสูง ใช้งานง่าย ปลอดภัย และอัปเดตตลอดเวลา
        </p>

        <!-- Search Bar -->
        <div class="relative max-w-xl mx-auto">
            <span class="absolute inset-y-0 left-0 flex items-center pl-4 pointer-events-none text-purple-400">
                <i class="fa-solid fa-magnifying-glass text-lg"></i>
            </span>
            <input 
                type="text" 
                id="searchInput" 
                oninput="filterScripts()"
                placeholder="ค้นหาสคริปต์จากชื่อ หรือผู้สร้าง..." 
                class="w-full pl-12 pr-4 py-3.5 rounded-2xl glassmorphism neon-border text-white placeholder-purple-300/50 focus:outline-none focus:ring-2 focus:ring-purple-500 text-sm sm:text-base"
            >
        </div>
    </section>

    <!-- Main Content Grid -->
    <main class="flex-grow px-4 sm:px-8 py-6 max-w-7xl mx-auto w-full">
        <div class="flex items-center justify-between mb-6">
            <h2 class="text-xl sm:text-2xl font-semibold flex items-center space-x-2">
                <i class="fa-solid fa-code text-neonPurple"></i>
                <span>รายการสคริปต์ทั้งหมด</span>
            </h2>
            <span id="scriptCount" class="text-xs sm:text-sm px-3 py-1 rounded-full bg-purple-950/60 border border-purple-800/50 text-purple-300">
                0 รายการ
            </span>
        </div>

        <!-- Scripts Grid Container -->
        <div id="scriptsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            <!-- Dynamically populated cards or empty state -->
        </div>
    </main>

    <!-- Discord Box Section -->
    <section class="px-4 sm:px-8 py-10 max-w-4xl mx-auto w-full">
        <div class="glassmorphism rounded-3xl p-6 sm:p-8 neon-border relative overflow-hidden flex flex-col sm:flex-row items-center justify-between gap-6 bg-gradient-to-br from-purple-950/40 via-cardBg to-darkBg">
            <div class="absolute -right-10 -bottom-10 opacity-10 pointer-events-none text-9xl text-purple-400">
                <i class="fa-brands fa-discord"></i>
            </div>
            <div class="flex items-center space-x-4 text-center sm:text-left">
                <div class="w-14 h-14 rounded-2xl bg-[#5865F2]/20 border border-[#5865F2]/40 flex items-center justify-center shrink-0 shadow-lg shadow-[#5865F2]/20">
                    <i class="fa-brands fa-discord text-3xl text-[#5865F2]"></i>
                </div>
                <div>
                    <h3 class="text-lg sm:text-xl font-bold text-white mb-1">เข้าร่วมชุมชน Sunlight Discord</h3>
                    <p class="text-xs sm:text-sm text-purple-200/70">พูดคุย แจ้งปัญหา แนะนำสคริปต์ หรือรับข่าวสารอัปเดตใหม่ๆ ได้ที่นี่!</p>
                </div>
            </div>
            <a 
                href="https://discord.gg/" 
                target="_blank" 
                rel="noopener noreferrer"
                class="neon-button text-white px-6 py-3 rounded-xl font-medium flex items-center space-x-2 shrink-0 text-sm sm:text-base"
            >
                <i class="fa-brands fa-discord text-lg"></i>
                <span>เข้าร่วมดิสคอร์ด</span>
            </a>
        </div>
    </section>

    <!-- Footer -->
    <footer class="border-t border-purple-900/30 py-6 text-center text-xs sm:text-sm text-purple-300/50 bg-darkBg/80">
        <p>&copy; 2026 Sunlight Hub. All rights reserved. กำลังหาติสอยู่รึป่าว? ติสพวกเรา</p>
    </footer>

    <!-- Admin Modal / Panel -->
    <div id="adminModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm hidden transition-all duration-300 opacity-0">
        <div class="glassmorphism neon-border rounded-3xl w-full max-w-lg p-6 sm:p-8 relative transform scale-95 transition-all duration-300" id="adminModalContent">
            <!-- Close Button -->
            <button onclick="toggleAdminModal(false)" class="absolute top-5 right-5 text-purple-300 hover:text-white w-9 h-9 rounded-full bg-purple-950/60 border border-purple-800/40 flex items-center justify-center transition-all">
                <i class="fa-solid fa-xmark text-lg"></i>
            </button>

            <div class="flex items-center space-x-3 mb-6">
                <div class="w-10 h-10 rounded-xl bg-purple-900/50 border border-purple-700/50 flex items-center justify-center text-neonPurple">
                    <i class="fa-solid fa-square-plus text-xl"></i>
                </div>
                <div>
                    <h3 class="text-xl font-bold text-white">Admin Panel - เพิ่มสคริปต์</h3>
                    <p class="text-xs text-purple-300/70">กรอกข้อมูลสคริปต์ใหม่เพื่อให้แสดงผลบนหน้าเว็บไซต์</p>
                </div>
            </div>

            <!-- Form -->
            <form id="scriptForm" onsubmit="handleFormSubmit(event)" class="space-y-4">
                <div>
                    <label class="block text-xs sm:text-sm font-medium text-purple-200 mb-1">ชื่อสคริปต์ <span class="text-pink-500">*</span></label>
                    <input 
                        type="text" 
                        id="scriptName" 
                        required 
                        placeholder="เช่น Sunlight Menu V2" 
                        class="w-full px-4 py-3 rounded-xl bg-black/40 border border-purple-800/50 text-white placeholder-purple-500/40 focus:outline-none focus:ring-2 focus:ring-purple-500 text-sm"
                    >
                </div>
                <div>
                    <label class="block text-xs sm:text-sm font-medium text-purple-200 mb-1">ชื่อผู้สร้าง <span class="text-pink-500">*</span></label>
                    <input 
                        type="text" 
                        id="scriptCreator" 
                        required 
                        placeholder="เช่น Sunlight Dev" 
                        class="w-full px-4 py-3 rounded-xl bg-black/40 border border-purple-800/50 text-white placeholder-purple-500/40 focus:outline-none focus:ring-2 focus:ring-purple-500 text-sm"
                    >
                </div>
                <div>
                    <label class="block text-xs sm:text-sm font-medium text-purple-200 mb-1">ลิงก์ดาวน์โหลด (URL) <span class="text-pink-500">*</span></label>
                    <input 
                        type="url" 
                        id="scriptUrl" 
                        required 
                        placeholder="https://example.com/script.lua" 
                        class="w-full px-4 py-3 rounded-xl bg-black/40 border border-purple-800/50 text-white placeholder-purple-500/40 focus:outline-none focus:ring-2 focus:ring-purple-500 text-sm"
                    >
                </div>
                <div>
                    <label class="block text-xs sm:text-sm font-medium text-purple-200 mb-1">คำอธิบายสคริปต์ <span class="text-pink-500">*</span></label>
                    <textarea 
                        id="scriptDesc" 
                        required 
                        rows="3" 
                        placeholder="อธิบายฟังก์ชันการทำงานคร่าวๆ ของสคริปต์..." 
                        class="w-full px-4 py-3 rounded-xl bg-black/40 border border-purple-800/50 text-white placeholder-purple-500/40 focus:outline-none focus:ring-2 focus:ring-purple-500 text-sm resize-none"
                    ></textarea>
                </div>

                <div class="flex items-center justify-end space-x-3 pt-2">
                    <button 
                        type="button" 
                        onclick="toggleAdminModal(false)" 
                        class="px-5 py-2.5 rounded-xl border border-purple-900/60 bg-transparent text-purple-300 hover:bg-purple-950/40 text-sm font-medium transition-all"
                    >
                        ยกเลิก
                    </button>
                    <button 
                        type="submit" 
                        class="neon-button px-6 py-2.5 rounded-xl text-white font-medium text-sm flex items-center space-x-2"
                    >
                        <i class="fa-solid fa-floppy-disk"></i>
                        <span>บันทึกข้อมูล</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Custom Notification Toast -->
    <div id="toast" class="fixed bottom-6 right-6 z-50 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none">
        <div class="glassmorphism neon-border px-5 py-3 rounded-2xl flex items-center space-x-3 shadow-2xl bg-purple-950/90">
            <div id="toastIcon" class="w-7 h-7 rounded-full bg-purple-600/30 text-neonPurple flex items-center justify-center shrink-0">
                <i class="fa-solid fa-check text-sm"></i>
            </div>
            <span id="toastMessage" class="text-sm font-medium text-white">ดำเนินการสำเร็จ</span>
        </div>
    </div>

    <!-- JavaScript Application Logic -->
    <script>
        // Storage Key
        const STORAGE_KEY = 'sunlight_scripts';

        // Default initial data if localStorage is empty
        const defaultScripts = [
            {
                id: '1',
                name: 'Sunlight Hub Ultimate Menu',
                creator: 'Sunlight Official',
                url: 'https://pastebin.com/raw/example1',
                description: 'สคริปต์ศูนย์รวมฟังก์ชันครบครัน ดีไซน์สวยงาม ลื่นไหล ไม่แลค รองรับทุกแพตช์ล่าสุด'
            },
            {
                id: '2',
                name: 'Auto Farm Pro Optimizer',
                creator: 'DevMasterX',
                url: 'https://pastebin.com/raw/example2',
                description: 'ระบบฟาร์มอร่อย ปรับแต่งความเร็วได้ดั่งใจ ป้องกันการเตะออกจากห้องได้เป็นอย่างดี'
            },
            {
                id: '3',
                name: 'ESP & Wallhack Visual',
                creator: 'CyberGhost',
                url: 'https://pastebin.com/raw/example3',
                description: 'มองทะลุกำแพง บอกระยะทางและสถานะเลือดเป้าหมายได้อย่างแม่นยำ ปลอดภัย 100%'
            }
        ];

        // Initialize scripts from localStorage or default
        function getScripts() {
            const data = localStorage.getItem(STORAGE_KEY);
            if (!data) {
                localStorage.setItem(STORAGE_KEY, JSON.stringify(defaultScripts));
                return defaultScripts;
            }
            try {
                return JSON.parse(data);
            } catch (e) {
                return defaultScripts;
            }
        }

        function saveScripts(scripts) {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(scripts));
        }

        // Render scripts grid
        function renderScripts(filterText = '') {
            const grid = document.getElementById('scriptsGrid');
            const countBadge = document.getElementById('scriptCount');
            const scripts = getScripts();

            // Filter scripts based on search query
            const filtered = scripts.filter(script => {
                const query = filterText.toLowerCase();
                return script.name.toLowerCase().includes(query) || script.creator.toLowerCase().includes(query);
            });

            countBadge.innerText = `${filtered.length} รายการ`;

            if (filtered.length === 0) {
                grid.innerHTML = `
                    <div class="col-span-full py-16 text-center flex flex-col items-center justify-center glassmorphism rounded-3xl neon-border border-dashed">
                        <div class="w-16 h-16 rounded-2xl bg-purple-900/20 border border-purple-800/40 flex items-center justify-center text-purple-400 mb-4 text-2xl shadow-inner">
                            <i class="fa-solid fa-folder-open"></i>
                        </div>
                        <h3 class="text-lg font-bold text-white mb-1">ยังไม่มีสคริปต์</h3>
                        <p class="text-sm text-purple-300/60 max-w-sm mb-4">ไม่พบสคริปต์ที่คุณค้นหา หรือยังไม่มีการเพิ่มข้อมูลสคริปต์ในระบบ</p>
                        <button onclick="toggleAdminModal(true)" class="neon-button text-white px-5 py-2.5 rounded-xl text-sm font-medium flex items-center space-x-2">
                            <i class="fa-solid fa-plus"></i>
                            <span>เพิ่มสคริปต์แรกเลย</span>
                        </button>
                    </div>
                `;
                return;
            }

            grid.innerHTML = filtered.map(script => `
                <div class="glassmorphism rounded-3xl p-6 neon-border flex flex-col justify-between group hover:-translate-y-1 transition-all duration-300 relative overflow-hidden">
                    <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-purple-600 via-neonPurple to-pink-500 opacity-60 group-hover:opacity-100 transition-opacity"></div>
                    <div>
                        <div class="flex items-start justify-between gap-2 mb-3">
                            <h3 class="text-lg font-bold text-white group-hover:text-neonPurple transition-colors line-clamp-1">${escapeHtml(script.name)}</h3>
                            <span class="text-xs px-2.5 py-1 rounded-lg bg-purple-900/40 border border-purple-700/40 text-purple-300 shrink-0 flex items-center space-x-1">
                                <i class="fa-solid fa-user text-[10px]"></i>
                                <span>${escapeHtml(script.creator)}</span>
                            </span>
                        </div>
                        <p class="text-xs sm:text-sm text-purple-200/70 mb-6 line-clamp-3 leading-relaxed">
                            ${escapeHtml(script.description)}
                        </p>
                    </div>
                    <div class="flex items-center space-x-3 pt-4 border-t border-purple-900/30">
                        <a 
                            href="${escapeHtml(script.url)}" 
                            target="_blank" 
                            rel="noopener noreferrer"
                            class="flex-1 neon-button text-white py-2.5 px-4 rounded-xl text-xs sm:text-sm font-medium flex items-center justify-center space-x-2 text-center"
                        >
                            <i class="fa-solid fa-download"></i>
                            <span>ดาวน์โหลด</span>
                        </a>
                        <button 
                            onclick="deleteScript('${script.id}')" 
                            title="ลบสคริปต์"
                            class="w-10 h-10 rounded-xl bg-red-950/40 border border-red-800/50 text-red-400 hover:bg-red-900/60 hover:text-white flex items-center justify-center transition-all shrink-0"
                        >
                            <i class="fa-solid fa-trash-can text-sm"></i>
                        </button>
                    </div>
                </div>
            `).join('');
        }

        // Search filter trigger
        function filterScripts() {
            const query = document.getElementById('searchInput').value;
            renderScripts(query);
        }

        // Admin modal toggle
        function toggleAdminModal(open) {
            const modal = document.getElementById('adminModal');
            const content = document.getElementById('adminModalContent');
            if (open) {
                modal.classList.remove('hidden');
                setTimeout(() => {
                    modal.classList.remove('opacity-0');
                    content.classList.remove('scale-95');
                    content.classList.add('scale-100');
                }, 10);
                document.getElementById('scriptName').focus();
            } else {
                modal.classList.add('opacity-0');
                content.classList.remove('scale-100');
                content.classList.add('scale-95');
                setTimeout(() => {
                    modal.classList.add('hidden');
                    document.getElementById('scriptForm').reset();
                }, 300);
            }
        }

        // Handle form submission for adding new script
        function handleFormSubmit(event) {
            event.preventDefault();
            const name = document.getElementById('scriptName').value.trim();
            const creator = document.getElementById('scriptCreator').value.trim();
            const url = document.getElementById('scriptUrl').value.trim();
            const description = document.getElementById('scriptDesc').value.trim();

            if (!name || !creator || !url || !description) {
                showToast('กรุณากรอกข้อมูลให้ครบถ้วนทุกช่อง', 'error');
                return;
            }

            const newScript = {
                id: Date.now().toString(),
                name,
                creator,
                url,
                description
            };

            const scripts = getScripts();
            scripts.unshift(newScript);
            saveScripts(scripts);

            toggleAdminModal(false);
            renderScripts(document.getElementById('searchInput').value);
            showToast('บันทึกสคริปต์ใหม่สำเร็จ!', 'success');
        }

        // Delete script with confirmation
        function deleteScript(id) {
            if (confirm('คุณต้องการลบสคริปต์นี้ออกจากระบบใช่หรือไม่?')) {
                let scripts = getScripts();
                scripts = scripts.filter(s => s.id !== id);
                saveScripts(scripts);
                renderScripts(document.getElementById('searchInput').value);
                showToast('ลบสคริปต์เรียบร้อยแล้ว', 'success');
            }
        }

        // Toast notification system
        function showToast(message, type = 'success') {
            const toast = document.getElementById('toast');
            const toastMessage = document.getElementById('toastMessage');
            const toastIcon = document.getElementById('toastIcon');

            toastMessage.innerText = message;
            if (type === 'error') {
                toastIcon.className = 'w-7 h-7 rounded-full bg-red-600/30 text-red-400 flex items-center justify-center shrink-0';
                toastIcon.innerHTML = '<i class="fa-solid fa-triangle-exclamation text-sm"></i>';
            } else {
                toastIcon.className = 'w-7 h-7 rounded-full bg-purple-600/30 text-neonPurple flex items-center justify-center shrink-0';
                toastIcon.innerHTML = '<i class="fa-solid fa-check text-sm"></i>';
            }

            toast.classList.remove('translate-y-20', 'opacity-0', 'pointer-events-none');
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0', 'pointer-events-none');
            }, 3000);
        }

        // Helper function for HTML escaping to prevent XSS
        function escapeHtml(str) {
            return str
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }

        // Initialize on load
        window.onload = function() {
            renderScripts();
        }
    </script>
</body>
</html>
